# Graphify Codex hooks stay machine-local: they carry an absolute path.
.codex/hooks.json

# Agent layer. Every harness config here is machine-local: it names absolute
# paths to locally installed binaries and differs per contributor. Only the
# planning artifacts under .claude/plans/ are shared.
.claude/*
!.claude/plans/
# The saved report bundle is a browser page dump with its own asset
# folder. It stays on disk for local reading and is not published.
.claude/plans/reports/REPORT.html
.claude/plans/reports/REPORT_files/
.agents/skills/
